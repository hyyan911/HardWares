<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Controls="clr-namespace:Controls;assembly=Controls" x:Class="HardWares.Windows.ConnectWindow"
        mc:Ignorable="d"
        Title="ConnectWindow" Height="500" Width="400"  BorderThickness="2" WindowStyle="None" ResizeMode="NoResize" Background="#FF1F1F1F" MouseMove="Window_MouseMove" BorderBrush="#FF0075DA">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="60"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Grid.Column="0" Content="    选择设备" Grid.Row="0" Height="30"  Background="#FF383838" HorizontalAlignment="Stretch" VerticalAlignment="Center" Foreground="LightGray"/>
        <Controls:DecoratedButton Grid.Row="0" Name="CloseBtn" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Column="1" Click="Close" Text="×" FontWeight="Thin" FontSize="20" Canvas.Left="594" Background="#FF383838" Foreground="LightGray" MoveInColor="#FF424242" PressedColor="#FF39393A" MoveInForeground="LightGray" PressedForeground="LightGray"/>
        <StackPanel Grid.Row="2" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.ColumnSpan="2" Orientation="Horizontal"/>
        <Grid Grid.Row="1" Grid.Column="0" Grid.RowSpan="3" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62*"/>
                <ColumnDefinition Width="101*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="DevicePanel" Visibility="Visible" Grid.ColumnSpan="2" Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Label Content="设备列表:" HorizontalContentAlignment="Center" Grid.Row="0" Grid.Column="0" VerticalContentAlignment="Center" Foreground="#FFFAFAFA" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="14"/>
                <Controls:ComboBox x:Name="DeviceTypeList" Grid.Column="1" PanelWidth="{Binding ElementName=DeviceTypeList, Path=ActualWidth}" TextAreaRatio="0.8" ImagePlace="Right" IconMargin="13" SelectionChanged="RefreshPort" HorizontalAlignment="Stretch" Margin="5" Height="40" VerticalAlignment="Stretch"  Background="#FF4D4D4D" PanelBackground="#FF1A1A1A" Foreground="#FFF0F0EC" MoveInForeground="#FFEAEAEA" PressedForeground="#FFF0F0F0" MoveInColor="#FF4D4D4D" IconSource="/HardWares;component/Image/downArrow.png">
                    <Controls:ComboBox.TemplateButton>
                        <Controls:DecoratedButton Background="#FF4D4D4D" Foreground="#FFF0F0EC" MoveInForeground="#FFEAEAEA" PressedForeground="#FFF0F0F0"/>
                    </Controls:ComboBox.TemplateButton>
                </Controls:ComboBox>
                <Controls:DecoratedButton Click="Connect" Text="连接" FontWeight="Bold" FontSize="14" Background="#FF4D4D4D" Foreground="LightGray" MoveInColor="#FF545454" PressedColor="#FF4C4C4C" MoveInForeground="LightGray" PressedForeground="LightGray" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.ColumnSpan="2" Margin="5" Grid.Row="3"/>
                <Label Name="Connecting" Visibility="Collapsed" Content="正在连接..." Grid.Row="4" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalContentAlignment="Right" Grid.ColumnSpan="2" VerticalContentAlignment="Center"/>
                <Label Name="Connected" Visibility="Collapsed" Content="连接成功" Grid.Row="4" FontSize="14" FontWeight="Bold" Foreground="#FF049513" HorizontalContentAlignment="Right" Grid.ColumnSpan="2" VerticalContentAlignment="Center"/>
                <Controls:ListViewer Grid.Row="1" Name="DeviceList" Visibility="Collapsed" Grid.RowSpan="2" Grid.ColumnSpan="2"  HeaderHeight="50" ItemHeight="40" ItemBarBackground="#FF1A1A1A" ItemBarSelectedColor="#FF0076EA">
                    <Controls:ListViewer.EditableBoxTemplate>
                        <TextBox TextAlignment="Center" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontSize="11" Foreground="White" CaretBrush="White"/>
                    </Controls:ListViewer.EditableBoxTemplate>
                    <Controls:ListViewer.DataTemplate>
                        <Controls:ViewerTemplate Descriptions="可连接设备" DataType="String" Editable="False" DataDisplayWidth="*"/>
                    </Controls:ListViewer.DataTemplate>
                    <Controls:ListViewer.HeaderLabelTemplate>
                        <Label HorizontalContentAlignment="Center" Grid.Row="0" VerticalContentAlignment="Center" Foreground="White" FontSize="14" FontWeight="Bold"/>
                    </Controls:ListViewer.HeaderLabelTemplate>
                    <Controls:ListViewer.UnEditableTextTemplate>
                        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Grid.Row="0" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="White" FontSize="10"/>
                    </Controls:ListViewer.UnEditableTextTemplate>
                    <Controls:ListViewer.EditableBooleanTemplate>
                        <Controls:Chooser Width="30" Height="15"/>
                    </Controls:ListViewer.EditableBooleanTemplate>
                </Controls:ListViewer>
                <Image Name="LoadingImage" Width="40" Visibility="Collapsed" Height="40" Grid.Row="1" RenderOptions.BitmapScalingMode="Fant" Grid.ColumnSpan="2" Grid.RowSpan="2" Source="/HardWares;component/Image/loading.png" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform x:Name="Rot" Angle="0"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </Grid>
    </Grid>
</Window>
